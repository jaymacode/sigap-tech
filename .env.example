# ============================================================================
# Sigap IT Service Desk — Environment Configuration
# ============================================================================
# Semua variabel memiliki nilai default yang siap jalan via docker compose up -d.
# Pengaturan ini ditujukan untuk evaluasi lokal / portfolio reviewer.

# Application
NODE_ENV=production
PORT=3000
APP_VERSION=1.0.0
DEMO_MODE=true

# Security & Session (statis untuk lokal, ganti pada server nyata)
AUTH_SECRET=local-only-not-secret-change-in-prod
CHANGE_WEBHOOK_TOKEN=local-change-token

# Internal Networking
SIGAP_WEB_URL=http://web:3000
DATABASE_URL=postgres://postgres:postgres@db:5432/sigap

# Host Port Mapping (ubah bila terjadi bentrok port)
SIGAP_PORT=3000
MAILPIT_PORT=8025
MINIO_CONSOLE_PORT=9001
MINIO_PORT=9000

# MinIO Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=sigap-attachments

