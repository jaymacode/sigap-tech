# Salin ke .env lalu sesuaikan. Tanpa .env, aplikasi berjalan dalam mode dev:
# SQLite lokal (data/sigap.db) + login/akun demo.

# --- Runtime ---
# NODE_ENV=production   # aktifkan cookie Secure (wajib HTTPS) & wajibkan SESSION_SECRET
# PORT=3000

# --- Database ---
DB_DRIVER=sqlite        # sqlite (dev, default) | postgres (produksi)
# DB_PATH=./data/sigap.db   # sqlite saja: path file, ":memory:", atau "memory-only"
# DATABASE_URL=postgres://sigap:sigap@localhost:5432/sigap   # wajib bila DB_DRIVER=postgres
# TEST_DATABASE_URL=postgres://sigap:sigap@localhost:5432/sigap_test   # opsional; DATABASE INI DIHAPUS ISINYA oleh tes

# --- Autentikasi ---
AUTH_MODE=demo          # demo (dev, default) | ims (produksi: login hanya via IMS perusahaan)
# SESSION_SECRET=       # min. 32 karakter; wajib bila NODE_ENV=production atau AUTH_MODE=ims
# IMS_ROLE_MAP=IT-HEAD:lead,IT-STAFF:agent,IT-ADMIN:admin   # grup IMS -> role; kosong = role dikelola di aplikasi

# --- Lampiran ---
# ATTACHMENT_DIR=./data/uploads   # disk lokal (1 instance); ganti ke S3/MinIO bila multi-instance
# ATTACHMENT_MAX_MB=10

# --- Email ---
MAIL_TRANSPORT=console  # console (dev: log) | file (tulis .eml ke MAIL_OUTBOX_DIR) | smtp
# MAIL_ENABLED=true     # false = tidak ada email yang diantrekan
# MAIL_FROM="Tim IT CTII <it@perusahaan.co.id>"
# MAIL_OUTBOX_DIR=./data/mail-outbox
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# APP_BASE_URL=http://localhost:3000   # dipakai untuk link di email & link persetujuan

# --- Persetujuan ---
# PRESDIR_EMAIL=        # kosong = Head IT mencatat persetujuan Presdir secara manual

# --- Webhook change ---
# CHANGE_WEBHOOK_TOKEN= # wajib di produksi (token dev bawaan ditolak saat NODE_ENV=production)
